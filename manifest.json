{
  "manifest_version": 3,
  "name": "Password Generator",
  "version": "1.0.0",
  "description": "Random password generator with selectable numbers, symbols, and fixed character lengths.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Password Generator"
  },
  "permissions": [
    "clipboardWrite"
  ],
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "15.0"
    }
  }
}
